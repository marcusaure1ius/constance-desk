DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=your-session-secret-here
# Все модели (DeepSeek, Whisper) — через OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
AGENT_API_KEY=your-agent-api-key-here
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-bot-token
TELEGRAM_ALLOWED_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
# 1 — бот разбирает, но задач не создаёт (отладка качества разбора)
TELEGRAM_CAPTURE_DRY_RUN=
# Выгрузка недельного слайда: JSON ключа сервисного аккаунта (или base64 от него)
GOOGLE_SERVICE_ACCOUNT_KEY=
# ID из URL docs.google.com/presentation/d/<ID>/edit
GOOGLE_SLIDES_PRESENTATION_ID=

# Локальная dev-база (docker-контейнер constance-dev-db, порт 55532): PIN для входа — 111111
# DATABASE_URL=postgresql://postgres:postgres@localhost:55532/constance
